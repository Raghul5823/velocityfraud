{
  "type": "record",
  "name": "TransactionEnrichedEvent",
  "namespace": "com.velocityfraud.enrichment",
  "doc": "An enriched scored transaction — echoes the original TransactionScoredEvent fields plus SHAP feature attributions and a natural-language narrative. Produced to topic transactions.enriched by the slow-path enricher (Layer 4) for events that the fast-path (Layer 3) flagged as REVIEW or BLOCK.",
  "fields": [
    { "name": "event_id",                 "type": "string",  "doc": "UUID copied from the source TransactionEvent." },
    { "name": "event_timestamp_ms",       "type": "long",    "doc": "Original transaction time (ms since epoch)." },
    { "name": "customer_id",              "type": "string",  "doc": "Stable customer identifier." },
    { "name": "card_token",               "type": "string",  "doc": "SHA-256 token of card concat." },
    { "name": "amount",                   "type": "double",  "doc": "Transaction amount in source currency." },
    { "name": "currency",                 "type": "string",  "doc": "ISO-4217 currency code." },
    { "name": "amount_fx_normalised",     "type": "double",  "doc": "Amount in canonical currency." },
    { "name": "merchant_id_hash",         "type": "string",  "doc": "Tokenized merchant identity." },
    { "name": "merchant_name",            "type": "string",  "doc": "Display-friendly merchant name." },
    { "name": "mcc",                      "type": "string",  "doc": "Merchant Category Code." },
    { "name": "merchant_country",         "type": "string",  "doc": "Two-char country code." },
    { "name": "ip_address_hash",          "type": "string",  "doc": "Hashed IP address." },
    { "name": "device_fingerprint_hash",  "type": "string",  "doc": "Hashed device fingerprint." },
    { "name": "geo_distance_km",          "type": "double",  "doc": "Distance from cardholder home." },
    { "name": "source_label",             "type": "string",  "doc": "Event origin label." },
    { "name": "schema_version",           "type": "string",  "doc": "Source schema version." },

    { "name": "fraud_score",              "type": "double",  "doc": "P(fraud) from the model." },
    { "name": "decision",                 "type": { "type": "enum", "name": "Decision", "symbols": ["ALLOW", "REVIEW", "BLOCK"] }, "doc": "Fast-path decision." },
    { "name": "model_name",               "type": "string",  "doc": "Model filename." },
    { "name": "model_version",            "type": "string",  "doc": "Model version tag." },
    { "name": "scored_at_ms",             "type": "long",    "doc": "When fast-path scoring completed." },
    { "name": "scoring_latency_ms",       "type": "long",    "doc": "Fast-path latency in ms." },
    { "name": "feature_completeness",     "type": "double",  "doc": "Fraction of features with real data." },

    {
      "name": "top_contributors",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "FeatureContribution",
          "fields": [
            { "name": "feature_name",  "type": "string", "doc": "Name of the feature." },
            { "name": "feature_value", "type": "double", "doc": "Numerical value the feature had for this event." },
            { "name": "shap_value",    "type": "double", "doc": "SHAP attribution: positive = pushes toward fraud, negative = pushes toward legit." }
          ]
        }
      },
      "doc": "Top 5 features by |shap_value| — what drove the model's decision for THIS event."
    },

    { "name": "narrative",                "type": "string", "doc": "Natural-language explanation of why this event was flagged. Generated by Gemini (if available) or a deterministic template. Empty string if a Gemini narrative was generated but FAILED the narrative_grader's factual/actionable check (proposal Section 10.3: 'failing narratives are dropped, not shown to analysts')." },
    { "name": "narrator_mode",            "type": { "type": "enum", "name": "NarratorMode", "symbols": ["TEMPLATE", "GEMINI", "GEMINI_CACHED"] }, "doc": "Which narrator produced the narrative. GEMINI_CACHED = a live Gemini call failed and a previously-cached successful narrative for this exact event_id was served instead (see narrator.py's pre-cache, proposal Risk #9)." },
    { "name": "narrative_grading_passed", "type": "boolean", "default": true, "doc": "Result of the second-Gemini-call factual/actionable grader (narrative_grader.py, proposal Section 10.3 'AI-validates-AI'). FALSE means the narrative field above was suppressed (set to empty string) because it failed grading. Always TRUE for TEMPLATE mode, which is not graded." },
    { "name": "enriched_at_ms",           "type": "long",   "doc": "When enrichment completed (ms since epoch)." },
    { "name": "enrichment_latency_ms",    "type": "long",   "doc": "End-to-end slow-path latency (consume to produce) in ms." }
  ]
}
