# Data — never commit raw or processed datasets
data/raw/*
data/processed/*
data/interim/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/interim/.gitkeep

# Models — never commit binary model artefacts
*.pkl
*.joblib
*.onnx
*.h5
mlruns/
mlartifacts/

