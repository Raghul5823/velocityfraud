# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# uv
.uv/

# Secrets & local config
.env
.env.local
.env.*.local
*.pem
*.key
secrets/

# Data — never commit raw or processed datasets
data/raw/*
data/processed/*
data/interim/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/interim/.gitkeep
# keep the tiny feature schema the app needs at inference time
!data/processed/feature_meta.json

# Models — never commit binary model artefacts
*.pkl
*.joblib
*.onnx
*.h5
mlruns/
mlartifacts/

# Logs
*.log
logs/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini

# Docker
.docker-data/

# Power BI temp
*.pbix.tmp

# Model binaries (*.pkl) are ignored above. Train locally or transfer via scp per
# docs/oracle_deploy.md. CHAMPION.txt + data/processed/feature_meta.json ARE tracked
# so the app knows which model + feature schema to load.

# Data exports (regenerated from Postgres for Databricks upload)
data/exports/

# Load-test generated output (k6-summary.json is kept as the cert artifact)
perf/locust_*.csv
